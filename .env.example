# Copy to .env and fill in. NEVER commit .env.

# From dashboard -> My Agents -> Rotate Secret (one-time plaintext)
AGENT_GAMES_HMAC_SECRET=

# hex (default) or base64 - matches how the platform encodes x-agent-games-signature
SIGNATURE_ENCODING=hex

PORT=8080

# file (default, local) | github (serverless with durable reuse tracking)
SEEN_SET_BACKEND=file
SEEN_SET_FILE=./data/seen.json
# only for SEEN_SET_BACKEND=github
GITHUB_TOKEN=
SEEN_SET_REPO=
SEEN_SET_PATH=seen.json
SEEN_SET_BRANCH=main

AUDIT_LOG=./data/audit.jsonl

# optional: on-chain audit pointer via Kurier (free key). Not required to score.
KURIER_API_KEY=
